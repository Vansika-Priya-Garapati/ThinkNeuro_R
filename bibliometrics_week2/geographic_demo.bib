@article{ WOS:000497601000040,
Author = {Xiao, Jingfeng and Chevallier, Frederic and Gomez, Cecile and Guanter,
   Luis and Hicke, Jeffrey A. and Huete, Alfredo R. and Ichii, Kazuhito and
   Ni, Wenjian and Pang, Yong and Rahman, Abdullah F. and Sun, Guoqing and
