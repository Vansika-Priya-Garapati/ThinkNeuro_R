Title = {Revisiting the historical distribution of Seasonally Dry Tropical
   Forests: new insights based on palaeodistribution modelling and
   palynological evidence},
Journal = {GLOBAL ECOLOGY AND BIOGEOGRAPHY},
Year = {2011},
Volume = {20},
Number = {2},
