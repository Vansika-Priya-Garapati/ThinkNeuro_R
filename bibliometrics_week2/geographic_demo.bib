Title = {Large stocks of peatland carbon and nitrogen are vulnerable to
   permafrost thaw},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
